# ============================================================
# Sales Timeshare — Variables de entorno
# Copia este archivo a .env.local y completa los valores.
# ============================================================

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Vite web (@salesapp/web) ---
# Vite incrusta estas vars en el JS. Para el vhost 187.77.14.148 NO uses
# la URL de Supabase Cloud: `python scripts/build-web-vps-prod.py` toma
# URL+ANON del .env de la VPS (prioridad sobre este archivo).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Express API (@salesapp/api) ---
API_PORT=4000
# Interfaz de escucha. En producción detrás de nginx SIEMPRE 127.0.0.1
# (default cuando NODE_ENV=production). En dev el default es 0.0.0.0.
API_HOST=127.0.0.1
# En Vercel producción usar SOLO: https://saletse.vercel.app
WEB_ORIGIN=http://localhost:5173
# Cookies Secure: se apagan solas si WEB_ORIGIN es http://. Forzar con "false".
# COOKIE_SECURE=false
SUPABASE_URL=
# Host público para URLs de Storage que el navegador abre (≠ loopback Kong en VPS)
SUPABASE_PUBLIC_URL=
SUPABASE_ANON_KEY=

# --- Vercel (producción) ---
# WEB_ORIGIN=https://saletse.vercel.app  (único dominio público de la app)

# Tipos de cambio (opcional; default https://api.frankfurter.dev/v1)
# FRANKFURTER_API_URL=https://api.frankfurter.dev/v1

# Solo servidor (NUNCA exponer en el cliente). Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# OneSignal (Settings → Keys & IDs en onesignal.com)
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
# Mismo App ID para el cliente Vite
VITE_ONESIGNAL_APP_ID=
# Safari Web ID (Settings → Web → copiar del snippet Custom Code)
ONESIGNAL_SAFARI_WEB_ID=
VITE_ONESIGNAL_SAFARI_WEB_ID=

# Sentry (opcional)
# Cliente web — fallos de vínculo OneSignal external_id, etc.
VITE_SENTRY_DSN=
# API (servidor) — fallos de email/soporte/upload; mismo DSN o proyecto separado
SENTRY_DSN=

# Resend (email transaccional — tickets de Atención a usuario)
RESEND_API_KEY=
# Remitente verificado en Resend, ej. Saletse Soporte <soporte@tudominio.com>
RESEND_FROM_EMAIL=
# Destino del equipo de soporte
SUPPORT_EMAIL=

# Cron Vercel / jobs programados (flush reminders + cleanup adjuntos soporte)
CRON_SECRET=

# Conexión directa para migraciones / Supabase CLI (Project Settings → Database)
DATABASE_URL=

# --- Scripts de deploy al VPS (solo local; nunca en el servidor) ---
# VPS_HOST=187.77.14.148
# VPS_USER=root
# Clave privada SSH (el password está deshabilitado en sshd desde el hardening)
# VPS_SSH_KEY=C:\Users\<usuario>\.ssh\saletse_vps_ed25519
