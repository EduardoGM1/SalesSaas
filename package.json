{
  "name": "sales-saas",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:api": "npm run dev -w @salesapp/api",
    "dev:web": "npm run dev -w @salesapp/web",
    "build": "npm run gen:icons && npm run build -w @salesapp/web",
    "build:api": "npm run start -w @salesapp/api",
    "build:web": "npm run build -w @salesapp/web",
    "start": "npm run start -w @salesapp/api",
    "start:prod": "node scripts/start-prod.mjs",
    "preview": "npm run preview -w @salesapp/web",
    "lint": "npm run build -w @salesapp/web",
    "gen:icons": "node scripts/generate-icons.mjs",
    "dev:clean": "node scripts/dev-clean.mjs",
    "sync:html-theme": "node scripts/sync-html-theme.mjs",
    "sync:shared": "node scripts/sync-shared.mjs",
    "verificar:arquitectura": "node scripts/architecture/run-verificar-arquitectura.mjs",
    "verificar:arquitectura:checks": "node scripts/architecture/check-layer-boundaries.mjs && node scripts/architecture/check-lazy-imports.mjs && node scripts/architecture/check-tool-contracts.mjs && node scripts/architecture/check-push-deeplinks.mjs && node scripts/architecture/check-shared-parity.mjs",
    "verificar:arquitectura:completo": "node scripts/architecture/run-completo.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "seed:eduardo": "node scripts/seed-eduardo-prospects.mjs",
    "db:migrate": "node scripts/apply-migration.mjs",
    "rh:bootstrap": "node scripts/bootstrap-royal-holiday.mjs",
    "rh:seed": "node scripts/seed-royal-holiday-catalog.mjs",
    "rh:flags": "node scripts/seed-rh-tool-flags.mjs",
    "rh:verify": "node scripts/verify-royal-holiday-case.mjs",
    "verify:flags": "node scripts/verify-flags-parity.mjs",
    "verify:workspaces": "node scripts/verify-workspaces.mjs",
    "verify:tenant-workflow": "node scripts/verify-tenant-rbac-workflow.mjs",
    "verify:security-smoke": "node scripts/verify-security-smoke.mjs",
    "verify": "node scripts/verify-smoke.mjs",
    "verify:vps": "node scripts/verify-vps-mobile.mjs",
    "verify:api": "npm run verify -w @salesapp/api",
    "test:web": "npm run test -w @salesapp/web",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:egress": "playwright test e2e/egress-payload.spec.js e2e/egress-realtime-idle.spec.js e2e/egress-sync-empty-local.spec.js",
    "audit:egress": "node scripts/audit-egress.js",
    "test:video-pdf": "node scripts/test-survey-calc.mjs && playwright test e2e/video-corrections.spec.js",
    "test:money-box": "node scripts/test-money-box.mjs",
    "test:rh-regalos": "node scripts/test-rh-regalos-cantidad-total.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "sharp": "^0.35.3",
    "ssim.js": "^3.5.0",
    "typescript": "^5"
  }
}
